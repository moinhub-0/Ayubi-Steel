rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || request.auth.token.email == 'moincomp06@gmail.com'); 
    }

    // Validations
    function isValidCategory(data) {
      return data.keys().hasAll(['title', 'createdAt', 'updatedAt']) 
        && data.keys().size() == 3
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidProduct(data) {
      // Assuming price is optional, let's just make it required for strictness, or handle optional keys.
      // We will make price required but maybe 0.
      return data.keys().hasAll(['title', 'description', 'categoryId', 'imageUrl', 'price', 'createdAt', 'updatedAt'])
        && data.keys().size() == 7
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.categoryId is string && isValidId(data.categoryId)
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.price is number
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['bannerTitle', 'bannerSubtitle', 'contactPhone', 'contactEmail', 'aboutTitle', 'aboutSubtitle', 'aboutFounderStory', 'homeBannerImage', 'aboutBannerImage', 'aboutFounderImage', 'updatedAt', 'address', 'instagramUrl', 'youtubeUrl'])
        && data.keys().size() == 14
        && data.bannerTitle is string && data.bannerTitle.size() <= 200
        && data.bannerSubtitle is string && data.bannerSubtitle.size() <= 600
        && data.contactPhone is string && data.contactPhone.size() <= 30
        && data.contactEmail is string && data.contactEmail.size() <= 100
        && data.aboutTitle is string && data.aboutTitle.size() <= 200
        && data.aboutSubtitle is string && data.aboutSubtitle.size() <= 600
        && data.aboutFounderStory is string && data.aboutFounderStory.size() <= 3000
        && data.homeBannerImage is string && data.homeBannerImage.size() <= 1000
        && data.aboutBannerImage is string && data.aboutBannerImage.size() <= 1000
        && data.aboutFounderImage is string && data.aboutFounderImage.size() <= 1000
        && data.address is string && data.address.size() <= 200
        && data.instagramUrl is string && data.instagramUrl.size() <= 300
        && data.youtubeUrl is string && data.youtubeUrl.size() <= 300
        && data.updatedAt is number;
    }

    function isValidTestimonial(data) {
      return (
          (data.keys().size() == 6 && data.keys().hasAll(['name', 'role', 'text', 'status', 'createdAt', 'updatedAt'])) ||
          (data.keys().size() == 7 && data.keys().hasAll(['name', 'role', 'text', 'image', 'status', 'createdAt', 'updatedAt']) && data.image is string && data.image.size() <= 1000)
        )
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.role is string && data.role.size() <= 100
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.status is string && data.status.matches('^(pending|approved|rejected)$')
        && data.createdAt is number
        && data.updatedAt is number;
    }

    // Routes
    match /categories/{categoryId} {
      // Publicly readable
      allow get: if isValidId(categoryId);
      allow list: if true; // No user specific constraint needed for public catalog list, wait - strict rule says "Every allow list block MUST explicitly evaluate existing() or resource.data." 
      // But for a completely public catalog, how do we evaluate resource data? We can check if it has a valid title.
      // "allow list: if resource.data.title is string;"
      
      allow create: if isAdmin() 
        && isValidId(categoryId)
        && isValidCategory(incoming());
        
      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
        
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      
      allow create: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId));
        
      allow update: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'categoryId', 'imageUrl', 'price', 'updatedAt']);
        
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && (isAdmin() || resource.data.status == 'approved');
      allow list: if isAdmin() || resource.data.status == 'approved';
      
      allow create: if isValidId(testimonialId)
        && isValidTestimonial(incoming())
        && incoming().status == 'pending';
        
      allow update: if isAdmin()
        && isValidId(testimonialId)
        && isValidTestimonial(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
        
      allow delete: if isAdmin() && isValidId(testimonialId);
    }

    match /settings/global {
      allow get: if true;
      allow create: if isAdmin()
        && isValidSettings(incoming());
      allow update: if isAdmin()
        && isValidSettings(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['bannerTitle', 'bannerSubtitle', 'contactPhone', 'contactEmail', 'aboutTitle', 'aboutSubtitle', 'aboutFounderStory', 'homeBannerImage', 'aboutBannerImage', 'aboutFounderImage', 'address', 'instagramUrl', 'youtubeUrl', 'updatedAt']);
    }

    match /messages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if true
        && incoming().keys().hasAll(['name', 'email', 'phone', 'message', 'createdAt', 'status'])
        && incoming().name is string
        && incoming().email is string
        && incoming().phone is string
        && incoming().message is string
        && incoming().createdAt is number
        && incoming().status is string;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId && isValidId(adminId);
      // No creates or updates allowed from client to prevent privilege escalation.
    }
  }
}
